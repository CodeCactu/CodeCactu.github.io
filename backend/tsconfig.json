{
  "compilerOptions": {
    "types": ["bun"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@fet/*": [ "./src/features/*" ],
      "@lib/*": [ "./src/lib/*" ],
      "@/*": [ "./src/*" ]
    }
  },
  "exclude": [ "node_modules", "_*" ]
}