---
import SquaresOverlayLayout from "@/layouts/SquaresOverlayLayout.astro"
import classes from "./page.module.css"
import GamesTable from "./_utils/GamesTable.svelte"
import { loadCactuJamGames } from "@fet/backends/cactu/cactuJamGame"
import { clientConfig } from "@/config.client"
import cn from "@lib/core/functions/createClassName"

const games = await loadCactuJamGames()
---
<SquaresOverlayLayout compact squaresSurfaceSize={20} squaresBodyClass={classes.gamesArea}>
  <main>
    <div>
      <h1>Cactujam!</h1>

      <GamesTable client:load />
    </div>
  </main>

  <Fragment slot="squares-body">
    <section class={cn( `prose`, classes.preview )}>
      <ul>
        <li>
          Najedź myszką na kafelek gry aby zobaczyć jej opis
        </li>

        <li>
          Kliknij na kafelek z grą aby panel gry zachował widoczność
        </li>

        <li>
          Przeciągaj gry z listy źródłowej na poszczególne wiersze kategorii
        </li>

        <li>
          Przeciagnij grę z tabeli ocen nad listę źródłową aby usunąć dany głos
        </li>

        <li>
          Rozdysponuj wszystkie gry we wszystkich kategoriach aby mieć ważny głos
        </li>
      </ul>
    </section>

    <section class={classes.listArea} data-source-area>
      <h3>Gry</h3>

      <ol class={classes.list}>
        {games.map( game => (
          <li
            class={classes.game}
            data-drag-id={game.id}
            style={game.thumbnailUri && `--bgr: url(${clientConfig.BACKEND_ORIGIN}${game.thumbnailUri})`}
          >
            <button class={classes.handle} popovertarget={`game-${game.id}`}>
              ☰
            </button>

            <address popover class={`prose ${classes.overview}`} id={`game-${game.id}`}>
              {game.author.avatarUri && (
                <img
                  src={game.author.avatarUri}
                  alt={`${game.author.name}'s avatar`}
                  width="128"
                  height="128"
                />
              )}

              <h3>{game.name}</h3>

              {game.description && <div>{game.description}</div>}

              <small>~{game.author.name}</small>

              <div class={classes.comment}>
                <h4>Komentarz dla uczestnika</h4>
                <textarea name="comment"></textarea>
              </div>
            </address>
          </li>
        ))}
      </ol>
    </section>
  </Fragment>
</SquaresOverlayLayout>
