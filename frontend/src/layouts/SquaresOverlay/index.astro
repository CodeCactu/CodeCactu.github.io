        v -1
        h -1
        v -1
        h  1
        v  1
        h  1
        v -2
        h -1
        v -2

        H 0
      " />
    </svg>

    {!Astro.props.straight && (
      <svg class={classes.squaresLb} viewBox="0 0 17 31">
        <rect x="13" y="29" width="1" height="1" />
        <rect x="15" y="30" width="2" height="1" />

        <path d="
          M 0 31
          h 12
          v -1
          h -1
          v -2
          h  1
