---
import "./RootLayout.css"
import ClientConfig from "@/config.astro"
import CactuShadyTrail from "@fet/dynamicBackgrounds/CactuShadyTrail/index.astro"
import CactuBlinkingLines from "@fet/dynamicBackgrounds/CactuBlinkingLines/index.astro"
import { ClientRouter } from 'astro:transitions'
import { Font } from "astro:assets"
---
<html lang="en">
	<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <title>Cactu</title>

    <Font cssVariable="--fontFamily-lato" preload />

    <ClientRouter/>
    <ClientConfig />
	</head>
	<body>
    <div class="page-content">
    	<slot />
    </div>

    <CactuBlinkingLines />
    <CactuShadyTrail />
	</body>
</html>
