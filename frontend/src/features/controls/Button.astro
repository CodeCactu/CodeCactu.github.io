---
import classes from "./Button.module.css"
import { select } from "@lib/core/functions"

interface Props {
  variant?: `yellow` | `green` | `brown`
  style?: astroHTML.JSX.CSSProperties
  disabled?: boolean
}

const variantClassName = select( Astro.props.variant, {
  "yellow" : classes.isYellow,
  "brown" : classes.isBrown,
} )
---

<button class:list={[ `button`, variantClassName ]} style={Astro.props.style} disabled={Astro.props.disabled}>
  <slot />
</button>
