{
  "name": "frontend",
  "type": "module",
  "version": "2.0.0",
  "scripts": {
    "dev": "bunx --bun astro dev",
    "build": "bunx --bun astro build",
    "preview": "bunx --bun astro preview",
    "astro": "bunx --bun astro",
    "check": "bun translations/translations.ts generate && bunx --bun astro check && bunx --bun svelte-check --tsconfig ./tsconfig.json --output human",
    "test": "bun test",
    "translations:generate": "bun translations/translations.ts generate",
    "translations:collect": "bun translations/translations.ts collect",
    "translations:update": "bun translations/translations.ts update"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.10",
    "@astrojs/svelte": "^9.1.2",
    "@tanstack/query-core": "^5.106.1",
    "astro": "^7.4.6",
    "sharp": "^0.35.5",
    "svelte": "^5.57.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/bun": "^1.4.4",
    "csstype": "^3.2.3",
    "svelte-check": "^4.7.8",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "@emnapi/runtime": "1.11.3"
  }
}
